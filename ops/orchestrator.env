# RSR orchestrator configuration -- read by scripts/orchestrator/loopcore.py.
# KEY=VALUE, one per line; `#` starts a comment. A variable set in the process
# environment overrides the value here.

# --- spend caps (USD) -- OWNER DECISION -------------------------------------------
# The tick REFUSES (exit 3, one notice on the rsr-digest issue) while either is
# UNSET. RSR_CYCLE_CAP is passed to every claude session as --max-budget-usd;
# RSR_NIGHT_CAP is the night's total across sessions, and reaching it writes
# .orchestrator/HALT. A session whose cost cannot be read is charged the whole
# RSR_CYCLE_CAP.
RSR_CYCLE_CAP=UNSET
RSR_NIGHT_CAP=UNSET

# --- the window (local wall clock) --------------------------------------------------
# Stop rules from docs/lab-notes/dispatch-2026-09-21-overnight.md ("Wall clock"):
# no new brief after 06:30, everything merged or parked by 07:30, the morning
# document final by 08:00. RSR_WINDOW_OPENS is when a night may begin (not in the
# stop rules; an assumption, the owner may move it).
RSR_WINDOW_OPENS=21:00
RSR_LAST_DISPATCH=06:30
RSR_PARK_BY=07:30
RSR_DIGEST_BY=08:00

# --- loop behaviour ---------------------------------------------------------------
# Live researcher sessions at once (compute contention is the slot/lane layer's job).
RSR_MAX_SESSIONS=2
# Failed attempts of ANY causes before an item is parked (two of the SAME cause
# park it regardless -- stop rule "Two failures with the same cause").
RSR_MAX_ATTEMPTS=3
# A manager cycle runs when something changed; otherwise at most this often.
RSR_MANAGER_INTERVAL_MIN=60
