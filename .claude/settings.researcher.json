{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(docs/owner/**)",
      "Edit(preregistration/**)",
      "Edit(docs/spec/**)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/settings*.json)",
      "Edit(.claude/hooks/**)",
      "Edit(ops/orchestrator.env)",
      "Edit(runs/canary/baseline*)",
      "Edit(measurements/ledger.json)",
      "Bash(launchctl *)",
      "Bash(caffeinate *)",
      "Bash(gh pr merge *)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push *--mirror*)",
      "Bash(* --no-verify*)",
      "Bash(git log --all*)",
      "Bash(git checkout night/*)",
      "Bash(git switch night/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|MultiEdit|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "RSR_PROFILE=researcher PYTHONPATH=\"$CLAUDE_PROJECT_DIR/scripts\" \"$CLAUDE_PROJECT_DIR/.venv/bin/python\" -m orchestrator.hooks pretooluse || { echo \"orchestrator pretooluse hook could not run; failing closed\" >&2; exit 2; }",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RSR_PROFILE=researcher PYTHONPATH=\"$CLAUDE_PROJECT_DIR/scripts\" \"$CLAUDE_PROJECT_DIR/.venv/bin/python\" -m orchestrator.hooks stop || { echo \"orchestrator stop hook could not run; failing closed\" >&2; exit 2; }",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "RSR_PROFILE=researcher PYTHONPATH=\"$CLAUDE_PROJECT_DIR/scripts\" \"$CLAUDE_PROJECT_DIR/.venv/bin/python\" -m orchestrator.hooks sessionstart",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RSR_PROFILE=researcher PYTHONPATH=\"$CLAUDE_PROJECT_DIR/scripts\" \"$CLAUDE_PROJECT_DIR/.venv/bin/python\" -m orchestrator.hooks sessionend",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
